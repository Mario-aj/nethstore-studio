# Copie para .env com `make init` (gera os segredos). Nunca faça commit do .env.

# Modo de deploy: lan (rede de casa, IP fixo e CA interna) ou public (domínio
# com Let's Encrypt). Ver docs/OPERACAO.md.
DEPLOY_MODE=lan

# Modo lan: IP fixo do computador na rede de casa.
LAN_HOST=192.168.1.50
# Modo public: domínio apontado para o servidor e e-mail para o Let's Encrypt.
PUBLIC_DOMAIN=
ACME_EMAIL=

# Origem pública da app: https://LAN_HOST no modo lan, https://PUBLIC_DOMAIN no public.
APP_ORIGIN=https://192.168.1.50
# Interface onde o Caddy publica 80 e 443 (0.0.0.0 = todas).
BIND_ADDR=0.0.0.0

DATABASE_PATH=/data/estudio.db
S3_ENDPOINT=http://garage:3900
S3_REGION=garage
S3_BUCKET=estudio
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
UPLOAD_PATH=/s3/estudio
MAX_UPLOAD_BYTES=15728640
MAX_PHOTOS_PER_BATCH=50
SESSION_TTL=720h
WORKERS=2
RETENTION_ORIGINALS_DAYS=30
RETENTION_BATCHES_DAYS=90
# Vazio: ligado no modo lan, desligado no public (docs/DECISOES.md, item 5).
LOGIN_GLOBAL_LOCKOUT=
LOG_LEVEL=info

GARAGE_RPC_SECRET=
GARAGE_ADMIN_TOKEN=
